<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    tools:context=".IngredientesActivity">

    <ImageButton
        android:id="@+id/btnAtras"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Volver a la cámara"
        android:src="@drawable/ic_atras"
        app:tint="@color/texto"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTitulo"
        style="@style/RecetaLo.Titulo"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="Mis Ingredientes"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/divisorTitulo"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/gris_borde"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilIngrediente"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:hint="Agregar ingrediente a mano"
        app:boxBackgroundColor="@color/blanco_input"
        app:boxStrokeColor="@color/verde_oliva"
        app:hintTextColor="@color/verde_oliva"
        app:layout_constraintTop_toBottomOf="@id/divisorTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnAgregarManual">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etIngredienteManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="40"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAgregarManual"
        style="@style/RecetaLo.BotonPrincipal"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="Agregar ingrediente"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:icon="@drawable/ic_agregar"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="@color/white"
        app:layout_constraintTop_toTopOf="@id/tilIngrediente"
        app:layout_constraintBottom_toBottomOf="@id/tilIngrediente"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvContador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:text="0 ingredientes"
        android:textColor="@color/verde_oliva"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tilIngrediente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/contenedorLista"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/fondo_lista"
        android:padding="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvContador"
        app:layout_constraintBottom_toTopOf="@id/tvAyuda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvIngredientes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="4dp" />

        <TextView
            android:id="@+id/tvListaVacia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="Tu lista está vacía.\nToma fotos de tus productos o agrégalos a mano."
            android:textColor="@color/texto_secundario"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvAyuda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp"
        android:text="Toca o desliza un ingrediente para quitarlo"
        android:textColor="@color/texto"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/btnVaciarLista"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVaciarLista"
        style="@style/RecetaLo.BotonPrincipal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:text="Vaciar lista"
        app:layout_constraintBottom_toTopOf="@id/btnRecetas"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSeguirEscaneando"
        style="@style/RecetaLo.BotonContorno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="Seguir escaneando"
        app:layout_constraintTop_toTopOf="@id/btnVaciarLista"
        app:layout_constraintBottom_toBottomOf="@id/btnVaciarLista"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRecetas"
        style="@style/RecetaLo.BotonPrincipal"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:text="Ver recetas"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
