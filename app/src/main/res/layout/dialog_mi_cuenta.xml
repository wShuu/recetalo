<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/crema"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="8dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_cuenta"
            app:tint="@color/verde_oliva" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Jhamil Puchuri" />

            <TextView
                android:id="@+id/tvCorreoCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp"
                tools:text="ejemplo@gmail.com" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/gris_borde" />

    <TextView
        style="@style/RecetaLo.TituloSeccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/cuenta_seguridad"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_candado"
            app:tint="@color/verde_oliva" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cuenta_dos_pasos"
                android:textColor="@color/texto"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cuenta_dos_pasos_ayuda"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDosPasos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        style="@style/RecetaLo.TituloSeccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/cuenta_mis_recetas"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/opcionHistorial"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_historial"
        android:drawableEnd="@drawable/ic_flecha_derecha"
        android:drawablePadding="12dp"
        android:drawableTint="@color/verde_oliva"
        android:gravity="center_vertical"
        android:text="@string/cuenta_historial"
        android:textColor="@color/texto"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/opcionFavoritos"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_estrella_borde"
        android:drawableEnd="@drawable/ic_flecha_derecha"
        android:drawablePadding="12dp"
        android:drawableTint="@color/verde_oliva"
        android:gravity="center_vertical"
        android:text="@string/cuenta_favoritos"
        android:textColor="@color/texto"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/gris_borde" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarSesion"
        style="@style/RecetaLo.BotonContorno"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:text="@string/cuenta_cerrar_sesion"
        android:textColor="@color/rojo_alerta"
        app:strokeColor="@color/rojo_alerta" />
</LinearLayout>
