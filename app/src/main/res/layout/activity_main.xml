<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCamara"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tvTitulo"
            style="@style/RecetaLo.Titulo"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="Toma una foto"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:id="@+id/btnCuenta"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cuenta_boton"
            android:src="@drawable/ic_cuenta"
            app:tint="@color/verde_oliva"
            app:layout_constraintTop_toTopOf="@id/tvTitulo"
            app:layout_constraintBottom_toBottomOf="@id/tvTitulo"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/divisorTitulo"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/gris_borde"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCamara"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/gris_camara"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/divisorTitulo"
            app:layout_constraintBottom_toTopOf="@id/tvIndicacion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:implementationMode="compatible"
                app:scaleType="fillCenter" />

            <ImageView
                android:id="@+id/ivResultado"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/gris_camara"
                android:contentDescription="Resultado de la detección"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progresoDeteccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/verde_oscuro" />

            <LinearLayout
                android:id="@+id/layoutSinPermiso"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="La cámara está desactivada.\nPuedes subir una imagen con el botón de galería,\nagregar ingredientes a mano o activar la cámara."
                    android:textColor="@color/texto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActivarCamara"
                    style="@style/RecetaLo.BotonPrincipal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Activar cámara" />
            </LinearLayout>

            <TextView
                android:id="@+id/bannerMalEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="12dp"
                android:background="@drawable/fondo_banner_alerta"
                android:drawableStart="@drawable/ic_alerta"
                android:drawablePadding="8dp"
                android:drawableTint="@color/white"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="@string/malogrado_titulo"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvIndicacion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Apunta al producto y toca el botón para capturarlo, o sube una imagen"
            android:textColor="@color/texto"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvContador"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvContador"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:text="Mis ingredientes (0)"
            android:textColor="@color/verde_oliva"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/scrollChips"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <HorizontalScrollView
            android:id="@+id/scrollChips"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/btnCapturar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsIngredientes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    app:chipSpacingHorizontal="6dp"
                    app:singleLine="true" />

                <TextView
                    android:id="@+id/tvSinIngredientes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="Aún no tienes ingredientes. ¡Toma una foto!"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />
            </FrameLayout>
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapturar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="Capturar y detectar ingrediente"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:backgroundTint="@color/verde_claro"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_obturador"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="36dp"
            app:iconTint="@null"
            app:strokeColor="@color/gris_borde"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnGaleria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Subir imagen desde la galería"
            app:backgroundTint="@color/verde_claro"
            app:elevation="2dp"
            app:fabSize="normal"
            app:srcCompat="@drawable/ic_galeria"
            app:tint="@color/verde_oscuro"
            app:layout_constraintTop_toTopOf="@id/btnCapturar"
            app:layout_constraintBottom_toBottomOf="@id/btnCapturar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCapturar" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnIrIngredientes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Ver mis ingredientes"
            app:backgroundTint="@color/verde_oscuro"
            app:elevation="2dp"
            app:fabSize="normal"
            app:srcCompat="@drawable/ic_pulgar"
            app:tint="@color/white"
            app:layout_constraintTop_toTopOf="@id/btnCapturar"
            app:layout_constraintBottom_toBottomOf="@id/btnCapturar"
            app:layout_constraintStart_toEndOf="@id/btnCapturar"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/layoutPermiso"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/crema"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingTop="72dp"
        android:visibility="gone"
        tools:visibility="gone">

        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="136dp"
            android:background="@drawable/fondo_icono_camara">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_camara" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Necesitamos tu cámara"
            android:textColor="@color/texto"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="La usamos para reconocer lo que\ntienes en tu despensa."
            android:textColor="@color/verde_oliva"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvPermisoBloqueado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="El permiso fue rechazado. Actívalo desde los ajustes del teléfono."
            android:textColor="@color/rojo_alerta"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPermitirAcceso"
            style="@style/RecetaLo.BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:text="Permitir acceso" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAhoraNo"
            style="@style/RecetaLo.BotonContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ahora no" />
    </LinearLayout>

</FrameLayout>
